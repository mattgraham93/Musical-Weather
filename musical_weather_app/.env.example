# Local Development Environment Variables
# Copy this to .env and fill in your actual values

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=musical-weather

# Environment
ENV=development
DEBUG=True

# MongoDB Configuration (if using local MongoDB instead of Google Cloud)
# MONGODB_URL=mongodb://localhost:27017/musical_weather
# MONGODB_DATABASE=musical_weather

# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# OpenWeatherMap API (if needed)
# Get from: https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# Last.fm API (if needed)
# Get from: https://www.last.fm/api
# LASTFM_API_KEY=your_lastfm_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Disable Google Cloud services for local development
DISABLE_GOOGLE_CLOUD=true